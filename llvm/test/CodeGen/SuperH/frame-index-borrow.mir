# RUN: llc -mtriple=sh3el-unknown-none-elf -run-pass=prolog-epilog -verify-machineinstrs %s -o - | FileCheck %s

# A byte store to a frame slot beyond @(15,Rn) needs r0 for the index. When
# no register is free, r0 is pushed and popped around the store. The push
# must read r0, or the scavenger, walking backwards, takes r0 as dead above
# the pop and hands it out for the earlier store while it still holds a value.

---
name: borrow
tracksRegLiveness: true
stack:
  - { id: 0, size: 64, alignment: 4 }
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r13

    ; CHECK-LABEL: name: borrow
    ; CHECK: $r15 = STLP $r0, $r15
    ; CHECK-NEXT: $r0 = MOVI 44
    ; CHECK-NEXT: STBX killed $r0, killed $r1, $r15
    ; CHECK-NEXT: $r0, $r15 = LDLP $r15
    ; CHECK: $r15 = STLP $r0, $r15
    ; CHECK-NEXT: $r0 = MOVI 43
    ; CHECK-NEXT: STBX killed $r0, killed $r13, $r15
    ; CHECK-NEXT: $r0, $r15 = LDLP $r15
    STB_FI killed $r1, %stack.0, 40
    $r1 = MOV $r2
    STB_FI killed $r13, %stack.0, 39
    RTS implicit $r0, implicit $r1, implicit $r2, implicit $r3, implicit $r4, implicit $r5, implicit $r6, implicit $r7, implicit $r8, implicit $r9, implicit $r10, implicit $r11, implicit $r12
...
